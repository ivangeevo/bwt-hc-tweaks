{
  "schemaVersion": 1,
  "id": "bwt_hct",
  "version": "${version}",
  "name": "Better With Time: HC Tweaks",
  "description": "Hardcore tweaks and features for Better With Time",
  "authors": [
    "ivangeevo"
  ],
  "contact": {},
  "license": "CC-BY-4.0",
  "icon": "assets/bwt_hct/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": ["org.btwr.bwt_hct.BWT_HCTModClient"],
    "main": ["org.btwr.bwt_hct.BWT_HCTMod"],
    "fabric-datagen": ["org.btwr.bwt_hct.BWT_HCTDataGenerator"],
    "modmenu": ["org.btwr.bwt_hct.config.BWT_HCTModMenu"],
    "emi": ["org.btwr.bwt_hct.emi.BWT_HCTEmiPlugin"]
  },
  "mixins": [
    "bwt-hc-tweaks.mixins.json",
    {
      "config": "bwt-hc-tweaks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "bwt": "${bwt_version}",
    "btwr_sl": ">=${btwr_sl_version}"
  },
  "accessWidener" : "bwt_hct.accesswidener"
}